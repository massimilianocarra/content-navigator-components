<?xml version="1.0" encoding="UTF-8"?>
<project name="ItalianLocationEDS" default="war" basedir=".">
    
    <description>Build WAR file per Italian Location EDS - Content Navigator 3.2.0</description>
    
    <!-- Proprietà del progetto -->
    <property name="app.name" value="ItalianLocationEDS"/>
    <property name="app.version" value="1.0.0"/>
    <property name="war.file" value="${app.name}.war"/>
    
    <!-- Directory -->
    <property name="src.dir" location="src"/>
    <property name="build.dir" location="build-war"/>
    <property name="classes.dir" location="${build.dir}/WEB-INF/classes"/>
    <property name="dist.dir" location="dist"/>
    <property name="lib.dir" location="lib"/>
    <property name="resources.dir" location="resources"/>
    <property name="webcontent.dir" location="WebContent"/>
    
    <!-- Librerie Content Navigator -->
    <property environment="env"/>
    <property name="icn.lib.dir" value="${env.ICN_LIB_DIR}"/>
    
    <!-- Classpath per la compilazione -->
    <path id="compile.classpath">
        <fileset dir="${icn.lib.dir}">
            <include name="**/*.jar"/>
        </fileset>
        <fileset dir="${lib.dir}" erroronmissingdir="false">
            <include name="*.jar"/>
        </fileset>
    </path>
    
    <!-- Target: init -->
    <target name="init">
        <echo message="Inizializzazione build WAR per ${app.name} v${app.version}"/>
        <mkdir dir="${build.dir}"/>
        <mkdir dir="${build.dir}/WEB-INF"/>
        <mkdir dir="${classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>
    
    <!-- Target: clean -->
    <target name="clean" description="Pulisce i file di build">
        <echo message="Pulizia directory di build WAR"/>
        <delete dir="${build.dir}"/>
        <delete file="${dist.dir}/${war.file}"/>
    </target>
    
    <!-- Target: compile -->
    <target name="compile" depends="init" description="Compila il codice sorgente">
        <echo message="Compilazione sorgenti Java per WAR"/>
        <javac srcdir="${src.dir}" 
               destdir="${classes.dir}"
               includeantruntime="false"
               encoding="UTF-8"
               source="1.8"
               target="1.8"
               debug="true">
            <classpath refid="compile.classpath"/>
            <!-- Compila solo i servlet, non il plugin -->
            <include name="**/servlets/**/*.java"/>
            <exclude name="**/filters/**/*.java"/>
            <exclude name="**/ItalianLocationPlugin.java"/>
        </javac>
    </target>
    
    <!-- Target: war -->
    <target name="war" depends="compile" description="Crea il WAR file">
        <echo message="Creazione WAR file"/>
        
        <!-- Copia web.xml -->
        <copy file="${webcontent.dir}/WEB-INF/web.xml" 
              todir="${build.dir}/WEB-INF"/>
        
        <!-- Copia i file JSON nelle classes (saranno nel classpath) -->
        <copy todir="${classes.dir}">
            <fileset dir="${resources.dir}">
                <include name="*.json"/>
            </fileset>
        </copy>
        
        <!-- Crea il WAR -->
        <war destfile="${dist.dir}/${war.file}" 
             webxml="${build.dir}/WEB-INF/web.xml">
            <classes dir="${classes.dir}"/>
            <webinf dir="${build.dir}/WEB-INF">
                <exclude name="web.xml"/>
            </webinf>
        </war>
        
        <echo message="WAR file creato: ${dist.dir}/${war.file}"/>
    </target>
    
    <!-- Target: rebuild -->
    <target name="rebuild" depends="clean,war" description="Pulisce e ricompila tutto">
        <echo message="Rebuild WAR completato"/>
    </target>
    
    <!-- Target: info -->
    <target name="info" description="Mostra informazioni sul progetto">
        <echo message="==========================================="/>
        <echo message="Applicazione: ${app.name}"/>
        <echo message="Versione: ${app.version}"/>
        <echo message="WAR: ${war.file}"/>
        <echo message="==========================================="/>
        <echo message="Directory sorgenti: ${src.dir}"/>
        <echo message="Directory build: ${build.dir}"/>
        <echo message="Directory distribuzione: ${dist.dir}"/>
        <echo message="Directory librerie ICN: ${icn.lib.dir}"/>
        <echo message="==========================================="/>
    </target>
    
</project>

